<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light scheme: dark status-bar icons so they stay visible. -->
    <style name="Theme.RegTrail" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/regtrail_window_background</item>
    </style>
</resources>
