<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      The mark: a value being followed through a program.

      Four nodes ascend left-to-right and are joined by a trail; the last node is
      ringed — the moment the trail is "hit". That is literally what the tool
      does: follow a register or a return value until you find where it matters.
      It reads at 48 dp because it is one thick stroke plus a few circles rather
      than a glyph.

      Geometry rules:
      - everything stays inside 21..87 (the 66 dp adaptive-icon safe zone), so no
        launcher mask clips the hit ring;
      - every stroke uses round caps/joins, because a mitre join on a diagonal
        turns into a visible spike at 24 dp;
      - the `monochrome` variant reuses this file and keeps only alpha, so
        nothing may depend on colour to stay legible.
    -->

    <!-- Trail. -->
    <path
        android:pathData="M30,76 L46,62 L58,70 L76,48"
        android:strokeColor="#FF7DE2C3"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Intermediate nodes. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M46,62m-4.6,0a4.6,4.6 0 1,0 9.2,0a4.6,4.6 0 1,0 -9.2,0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M58,70m-4.6,0a4.6,4.6 0 1,0 9.2,0a4.6,4.6 0 1,0 -9.2,0" />

    <!-- Start node: hollow, so the eye knows where the trail begins. -->
    <path
        android:fillColor="#FF0E141D"
        android:strokeColor="#FF7DE2C3"
        android:strokeWidth="4"
        android:pathData="M30,76m-4.6,0a4.6,4.6 0 1,0 9.2,0a4.6,4.6 0 1,0 -9.2,0" />

    <!-- Hit ring + solid hit node. -->
    <path
        android:strokeColor="#B37DE2C3"
        android:strokeWidth="3"
        android:pathData="M76,48m-10,0a10,10 0 1,0 20,0a10,10 0 1,0 -20,0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M76,48m-6,0a6,6 0 1,0 12,0a6,6 0 1,0 -12,0" />
</vector>
